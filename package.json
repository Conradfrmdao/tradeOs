{
  "name": "tradeos",
  "private": true,
  "version": "0.1.0",
  "description": "TradeOS — MT4/MT5 multi-account manager & trade copier",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run db:generate && npm run build -w @tradeos/shared && npm run build -w @tradeos/api && npm run build -w @tradeos/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @tradeos/api",
    "dev:web": "npm run dev -w @tradeos/web",
    "db:generate": "prisma generate --schema packages/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/schema.prisma",
    "db:seed": "node --env-file=.env apps/api/dist/scripts/seed.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "typecheck": "npm run typecheck -w @tradeos/shared && npm run typecheck -w @tradeos/api && npm run typecheck -w @tradeos/web",
    "test": "npm run test -w @tradeos/api",
    "admin": "tsx --env-file=.env apps/api/src/scripts/admin.ts",
    "start": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3"
  }
}
