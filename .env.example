# ---------------------------------------------------------------------------
# TradeOS environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://tradeos:tradeos@localhost:5432/tradeos?schema=public

# --- Redis (optional in dev; required for multi-instance deployments) -----
# Used for cross-instance realtime fan-out and distributed rate limiting.
# Leave empty to fall back to in-process implementations.
REDIS_URL=redis://localhost:6379

# --- API ------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the web app, used for links in emails and CORS.
WEB_ORIGIN=http://localhost:3000
# Public origin of this API, handed to MT4/MT5 agents during pairing.
API_PUBLIC_URL=http://localhost:4000

# --- Secrets --------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_32_BYTES_MINIMUM_base64url
# AES-256-GCM key for encrypting sensitive account material at rest.
# Must be 32 bytes, base64 encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Bump when you rotate ENCRYPTION_KEY (see docs/SECURITY.md).
ENCRYPTION_KEY_VERSION=1

# --- Mail -----------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TradeOS <no-reply@tradeos.local>"

# --- Product limits (PRD §38 — configurable, not hard-coded) --------------
MAX_FOLLOWER_ACCOUNTS=10
MAX_MASTER_ACCOUNTS=1

# --- Trading engine tuning ------------------------------------------------
# Seconds without an agent sync before an account is marked DISCONNECTED.
AGENT_HEARTBEAT_TIMEOUT_SECONDS=30
# How often agents are told to poll, in milliseconds.
AGENT_POLL_INTERVAL_MS=1000
# Max attempts for a single copy task before it is parked as FAILED.
COPY_MAX_ATTEMPTS=3
# A copy task older than this is abandoned rather than executed late.
COPY_TASK_TTL_SECONDS=60

# --- Frontend (apps/web) --------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
